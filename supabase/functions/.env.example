# supabase secrets set --env-file supabase/functions/.env

# NIPOST: delete NIPOST_BASE_URL and MOCK_ECHO_POSTCODE once you use a real key
NIPOST_API_KEY=
NIPOST_BASE_URL=
MOCK_ECHO_POSTCODE=

# Paystack (sk_test_... until you go live)
PAYSTACK_SECRET_KEY=
SITE_URL=https://groundproof.site

# Claude photo comparison (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Testing only: let emulator check-ins through. Remove before pilots.
ALLOW_EMULATOR=true

# Owner email alerts (Resend). Without these, alerts are skipped.
RESEND_API_KEY=
ALERT_FROM=Groundproof <alerts@groundproof.site>
